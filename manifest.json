{
  "manifest_version": 3,
  "name": "Nintendo Rewards Monitor FR",
  "version": "1.0",
  "description": "Surveille les nouvelles récompenses Nintendo disponibles en France",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://store.nintendo.com/fr-fr/my-nintendo/my-nintendo-rewards*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nintendo Rewards Monitor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
